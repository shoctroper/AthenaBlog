---
import { getPublishedPosts } from '../../lib/posts'; import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() { const tags = new Set((await getPublishedPosts()).flatMap((p) => p.data.tags)); return [...tags].map((tag) => ({ params:{ tag }, props:{ tag } })); }
const { tag } = Astro.props; const posts = (await getPublishedPosts()).filter((p) => p.data.tags.includes(tag));
---
<BaseLayout title={`Tema: ${tag} · Mario Colli`} description={`Entradas sobre ${tag}.`}><p class="eyebrow">Tema</p><h1>{tag}</h1>{posts.map((post) => <p><a href={`/posts/${post.id}/`}>{post.data.title}</a></p>)}</BaseLayout>
