---
import { render } from 'astro:content';
import { getPublishedPosts, getPublishedPostsByDate } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrevNext from '../../components/PrevNext.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import NewsletterCta from '../../components/NewsletterCta.astro';
export async function getStaticPaths() { return (await getPublishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props; const { Content } = await render(post);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'http://localhost:4321';
const posts = await getPublishedPostsByDate();
const currentIndex = posts.findIndex((item) => item.id === post.id);
const related = posts.filter((item) => item.id !== post.id && item.data.tags.some((tag) => post.data.tags.includes(tag))).slice(0, 3);
const articleJsonLd = { '@context':'https://schema.org', '@type':'Article', headline:post.data.title, description:post.data.description, datePublished:post.data.pubDate.toISOString(), mainEntityOfPage:`${site}/posts/${post.id}/`, keywords:post.data.tags.join(', ') };
---
<BaseLayout title={`${post.data.title} · Mario Colli`} description={post.data.description} socialImage={post.data.heroImage || `/social/${post.id}.png`}>
  <article class="article-body"><p class="category-chip">{post.data.tags[0]} · {post.data.readingTime} de lectura</p><h1>{post.data.title}</h1><p class="lede">{post.data.description}</p><div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-MX', { day:'numeric', month:'long', year:'numeric' })}</time><span aria-hidden="true"></span><div class="tags">{post.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div></div><div class="article-content"><Content /></div>{post.data.pullQuote && <aside class="pull-quote"><p>“{post.data.pullQuote}”</p></aside>}{post.data.videoUrl && <p><a class="pill" href={post.data.videoUrl}>Ver el video de esta entrada</a></p>}<PrevNext previous={posts[currentIndex + 1]} next={posts[currentIndex - 1]} /><RelatedPosts posts={related} /><NewsletterCta /></article>
  <style>.category-chip{display:inline-flex;align-items:center;min-height:30px;margin:0 0 .85rem;padding:.25rem .7rem;border-radius:999px;background:var(--accent);color:#fff;font:700 11px/1 var(--sans);letter-spacing:.1em;text-transform:uppercase}.article-body h1{font-size:clamp(2rem,5vw,2.75rem);line-height:1.15}.article-meta{display:flex;align-items:center;flex-wrap:wrap;gap:.7rem;margin:0 0 2.25rem;padding:0 0 1rem;border-bottom:1px solid transparent;border-image:linear-gradient(90deg,#E0D2C2,transparent) 1}.article-meta time{font-family:var(--display)}.article-meta>span{width:18px;height:1px;background:var(--line)}.article-body .tag{background:transparent;color:var(--ink);font:600 11px/1 var(--sans)}:global(.article-content>p:first-child::first-letter){float:left;margin:.06em .13em 0 0;padding:5px 10px 0 0;color:#C4664A;font:3.4em/.82 var(--display)}:global(.article-content hr){display:grid;place-items:center;margin:24px 0;border:0}:global(.article-content hr::after){content:'◆ ◆ ◆';color:#C4664A;font:11px/1 var(--sans);letter-spacing:.5em}:global(.article-content hr:last-child){display:none}.pull-quote{margin:22px 0;padding:0 0 0 1.2rem;border-left:3px solid #C4664A;border-radius:0;color:#26221E;font:italic 19px/1.5 var(--display)}.pull-quote p{margin:0}@media(max-width:560px){:global(.article-content>p:first-child::first-letter){font-size:2.6em;float:none;padding:0;margin:0 .06em 0 0}}</style>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
</BaseLayout>
